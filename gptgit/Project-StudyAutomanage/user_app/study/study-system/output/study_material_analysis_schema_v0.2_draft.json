{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:study-material-analysis:0.2-draft",
  "title": "Study Material AI Analysis v0.2 draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "material_type",
    "summary",
    "schema_version",
    "sections"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "filename",
        "extension"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9]+$"
        }
      }
    },
    "material_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_type",
        "confidence",
        "reason"
      ],
      "properties": {
        "material_type": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "개념",
            "참고자료",
            "실습",
            "프로젝트",
            "문제/예제",
            "기타"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]+$"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/keyword"
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "theory": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/principle"
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparison"
          }
        }
      }
    },
    "practice": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/practice"
      }
    },
    "schema_version": {
      "const": "0.2-draft"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/external_reference"
      }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/topic"
          }
        }
      }
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "subtype"
          ],
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "subtype": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "relation",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "content",
        "evidence"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "content",
        "evidence"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_a",
        "subject_b",
        "criteria",
        "evidence"
      ],
      "properties": {
        "subject_a": {
          "type": "string",
          "minLength": 1
        },
        "subject_b": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "content_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/(concepts/[0-9]+|relationships/[0-9]+|practice/[0-9]+|theory/(definitions|principles|comparisons)/[0-9]+)$"
          }
        },
        "comment": {
          "$ref": "#/$defs/comment"
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "reference_ids"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "supplement",
            "correction"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "external_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "source_checked",
            "unverified"
          ]
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "source_checked"
              }
            }
          },
          "then": {
            "required": [
              "checked_on"
            ]
          }
        }
      ]
    }
  },
  "description": "검토용 초안. v0.1 원문 분석에 큰 주제 단락과 선택적 보충/정정 코멘트 및 외부 출처를 추가한다. 운영 Analyzer에는 아직 적용하지 않는다."
}
