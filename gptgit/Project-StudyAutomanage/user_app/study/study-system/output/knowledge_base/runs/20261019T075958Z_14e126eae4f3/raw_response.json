"{\n  \"material_type\": {\n    \"material_type\": \"개념\",\n    \"confidence\": 0.88,\n    \"reason\": \"OSI 7계층의 역할과 이더넷 프레임·IPv4 헤더의 항목을 설명하는 것이 중심입니다. 일부 확인 방법과 수치 메모가 포함되어 있고, 뒤쪽에는 네트워크와 직접 관련성이 불명확한 메모리 분류가 섞여 있습니다.\"\n  },\n  \"summary\": \"OSI 7계층의 역할과 장점, 이더넷 프레임 및 IPv4 헤더 항목을 설명하며 일부 확인 방법과 별도 메모를 포함한다.\",\n  \"topics\": [\n    {\n      \"name\": \"네트워크 모델\",\n      \"children\": [\n        {\n          \"name\": \"OSI 7계층\",\n          \"children\": null\n        }\n      ]\n    },\n    {\n      \"name\": \"네트워크 데이터 구조\",\n      \"children\": [\n        {\n          \"name\": \"이더넷 프레임\",\n          \"children\": null\n        },\n        {\n          \"name\": \"IPv4 패킷 헤더\",\n          \"children\": null\n        }\n      ]\n    }\n  ],\n  \"keywords\": [\n    {\n      \"name\": \"OSI 7계층\",\n      \"type\": \"네트워크 모델\"\n    },\n    {\n      \"name\": \"캡슐화\",\n      \"type\": \"네트워크 처리\"\n    },\n    {\n      \"name\": \"이더넷 프레임\",\n      \"type\": \"데이터 링크 계층\"\n    },\n    {\n      \"name\": \"IPv4\",\n      \"type\": \"네트워크 계층\"\n    },\n    {\n      \"name\": \"MTU\",\n      \"type\": \"패킷 크기\"\n    }\n  ],\n  \"concepts\": [\n    {\n      \"name\": \"OSI 7계층\",\n      \"description\": \"자료는 계층을 application, presentation, session, transport, network, datalink, physical 순서로 제시하고, 각 계층의 역할을 프로그램 실행, 표현·압축·암호화, 세션 관리, 전송 프로토콜·포트, IP 주소·경로, LAN/WAN 구분, 신호 변환 등으로 설명한다.\",\n      \"type\": {\n        \"category\": \"네트워크 모델\",\n        \"subtype\": \"계층 구조\"\n      }\n    },\n    {\n      \"name\": \"이더넷 프레임\",\n      \"description\": \"자료는 프레임의 항목으로 preamble, SFD, 목적지 MAC, 출발지 MAC, 선택적 802.1Q 태그, EtherType/type-or-length, 데이터, FCS를 열거하고 각 항목의 크기나 용도를 설명한다. 일부 설명은 원문에 제시된 내용이며 별도 검증은 제공되지 않았다.\",\n      \"type\": {\n        \"category\": \"네트워크 데이터 구조\",\n        \"subtype\": \"프레임\"\n      }\n    },\n    {\n      \"name\": \"IPv4 패킷 헤더\",\n      \"description\": \"자료는 IPv4 패킷의 total length, identification, fragment offset, protocol 필드를 언급한다. total length는 패킷 전체 길이로 설명하고, identification과 fragment offset은 데이터 그룹 및 조각의 순서와 관련된다고 설명한다.\",\n      \"type\": {\n        \"category\": \"네트워크 데이터 구조\",\n        \"subtype\": \"패킷 헤더\"\n      }\n    },\n    {\n      \"name\": \"MTU\",\n      \"description\": \"자료는 MTU를 장비가 보낼 수 있는 최대 길이로 설명하고, 일반적인 이더넷 통신에서 1500바이트를 사용한다고 적는다. 이 설명은 원문의 서술이며 조건이나 추가 검증은 제시되지 않았다.\",\n      \"type\": {\n        \"category\": \"네트워크 전송\",\n        \"subtype\": \"최대 전송 단위\"\n      }\n    }\n  ],\n  \"relationships\": null,\n  \"theory\": {\n    \"definitions\": [\n      {\n        \"subject\": \"OSI 7계층과 계층별 역할\",\n        \"content\": \"자료는 application에서 physical까지의 7계층을 나열한다. 프로그램 실행과 표현, 세션 유지·종료, 전송 프로토콜과 포트 지정, IP 주소·경로, LAN/WAN 구분, 신호 변환을 계층별 기능으로 설명하고, 계층적 이해가 프로토콜 이해·장비 호환·장애 대응에 도움이 된다고 제시한다. 게임 실행 사례도 같은 계층 구분에 대응시킨다.\",\n        \"evidence\": {\n          \"start_line\": 1,\n          \"end_line\": 48\n        }\n      },\n      {\n        \"subject\": \"이더넷 프레임 항목\",\n        \"content\": \"자료는 preamble 7바이트, SFD 1바이트, 목적지 및 출발지 MAC 각 6바이트, 802.1Q 태그 4바이트, EtherType 2바이트, FCS 4바이트를 기재하고 데이터 영역을 페이로드라고 부른다. preamble과 SFD는 NIC 버퍼에 저장 후 시작되면 버린다고 서술하며, MAC 주소와 EtherType의 역할도 설명한다.\",\n        \"evidence\": {\n          \"start_line\": 55,\n          \"end_line\": 73\n        }\n      },\n      {\n        \"subject\": \"IPv4 패킷 헤더 및 MTU 관련 필드\",\n        \"content\": \"자료는 total length를 패킷 전체 길이로 설명하고 이론상 최대 길이를 65536바이트로 기재한다. MTU는 장비가 보낼 수 있는 최대 길이로 설명하며, 일반적인 이더넷 통신에서 1500바이트를 사용한다고 적는다. identification, fragment offset, protocol 필드도 언급하지만, 일부 필드 설명은 원문 표현 그대로이며 추가 검증은 제공되지 않았다.\",\n        \"evidence\": {\n          \"start_line\": 75,\n          \"end_line\": 85\n        }\n      }\n    ],\n    \"principles\": null,\n    \"comparisons\": null\n  },\n  \"practice\": null,\n  \"schema_version\": \"0.2\",\n  \"sections\": [\n    {\n      \"id\": \"osi-layers\",\n      \"title\": \"OSI 7계층과 역할\",\n      \"content_refs\": [\n        \"/concepts/0\",\n        \"/theory/definitions/0\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"ethernet-frame\",\n      \"title\": \"이더넷 프레임 구조\",\n      \"content_refs\": [\n        \"/concepts/1\",\n        \"/theory/definitions/1\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"ipv4-header\",\n      \"title\": \"IPv4 패킷 헤더와 MTU\",\n      \"content_refs\": [\n        \"/concepts/2\",\n        \"/concepts/3\",\n        \"/theory/definitions/2\"\n      ],\n      \"comment\": null\n    }\n  ],\n  \"review_candidates\": null\n}"
