"{\n  \"material_type\": {\n    \"material_type\": \"실습\",\n    \"confidence\": 0.78,\n    \"reason\": \"R1·R2의 인터페이스와 RIP 설정, SSH 접속을 위한 설정 및 접속 명령이 중심이며 실제 성공 여부는 기록되지 않았습니다. IPv4 주소·클래스 설명도 함께 포함되어 있습니다.\"\n  },\n  \"summary\": \"R1·R2의 인터페이스와 RIP 및 SSH 설정 예시를 제시하고, IPv4 주소와 클래스 관련 메모를 덧붙인 자료입니다.\",\n  \"topics\": [\n    {\n      \"name\": \"네트워크 장비 설정\",\n      \"children\": [\n        {\n          \"name\": \"인터페이스 IP 주소 설정\",\n          \"children\": null\n        },\n        {\n          \"name\": \"RIP 설정\",\n          \"children\": null\n        },\n        {\n          \"name\": \"SSH 원격 접속\",\n          \"children\": null\n        }\n      ]\n    },\n    {\n      \"name\": \"IPv4\",\n      \"children\": [\n        {\n          \"name\": \"서브넷 마스크와 비트 표현\",\n          \"children\": null\n        },\n        {\n          \"name\": \"IPv4 주소 클래스\",\n          \"children\": null\n        }\n      ]\n    }\n  ],\n  \"keywords\": [\n    {\n      \"name\": \"RIP\",\n      \"type\": \"라우팅 프로토콜\"\n    },\n    {\n      \"name\": \"SSH\",\n      \"type\": \"원격 접속 프로토콜\"\n    },\n    {\n      \"name\": \"VTY\",\n      \"type\": \"가상 회선\"\n    },\n    {\n      \"name\": \"서브넷 마스크\",\n      \"type\": \"IPv4\"\n    },\n    {\n      \"name\": \"D 클래스\",\n      \"type\": \"IPv4 주소 클래스\"\n    }\n  ],\n  \"concepts\": [\n    {\n      \"name\": \"라우터 인터페이스 IP 주소 설정\",\n      \"description\": \"R1의 Fa0/0에 192.168.1.254/24, S1/0에 192.168.12.1/24를 설정하고, R2의 Fa0/0에 192.168.2.254/24, S1/0에 192.168.12.2/24를 설정하는 명령 예시가 있습니다. 각 인터페이스에 no shutdown 명령도 제시되어 있으나 실행 결과는 기록되지 않았습니다.\",\n      \"type\": {\n        \"category\": \"설정\",\n        \"subtype\": \"인터페이스\"\n      }\n    },\n    {\n      \"name\": \"RIP 설정\",\n      \"description\": \"R1은 192.168.1.0 및 192.168.12.0, R2는 192.168.2.0 및 192.168.12.0을 대상으로 router rip 아래에 network 명령을 입력하는 예시가 있습니다. 설정 또는 라우팅 결과는 기록되지 않았습니다.\",\n      \"type\": {\n        \"category\": \"설정\",\n        \"subtype\": \"라우팅\"\n      }\n    },\n    {\n      \"name\": \"SSH 원격 접속\",\n      \"description\": \"자료는 SSH를 암호문으로 통신하는 원격 접속용 프로토콜이라고 설명합니다. R2에서 SSH 관련 설정을 제시하고 R1에서 R2 주소로 접속하는 명령을 적었으나, 접속 성공 여부는 확인되지 않았습니다.\",\n      \"type\": {\n        \"category\": \"프로토콜\",\n        \"subtype\": \"원격 접속\"\n      }\n    },\n    {\n      \"name\": \"SSH 구성 요소\",\n      \"description\": \"구성 시 필요한 조건으로 로컬 계정, 특권 암호, 도메인 지정, 암호화 알고리즘과 키 길이 지정, 가상 회선 범위를 열거합니다. R2 설정 예시에는 로컬 로그인과 VTY 범위가 포함되어 있으며 키 생성 명령은 물음표 도움말 표기에서 끝납니다.\",\n      \"type\": {\n        \"category\": \"설정 요소\",\n        \"subtype\": \"인증 및 가상 회선\"\n      }\n    },\n    {\n      \"name\": \"IPv4 서브넷 마스크\",\n      \"description\": \"자료는 192.168.1.1/24의 주소와 마스크를 이진수로 적고, 마스크 연산을 AND 연산으로 설명합니다. 또한 서브넷 마스크를 통해 주소를 매핑한다고 기록합니다.\",\n      \"type\": {\n        \"category\": \"주소 체계\",\n        \"subtype\": \"서브넷 마스크\"\n      }\n    },\n    {\n      \"name\": \"IPv4 주소 클래스\",\n      \"description\": \"자료는 IPv4 주소를 MSB로 식별하는 5개 클래스로 구분한다고 설명하며, 224.30.54.70의 첫 옥텟 224를 1110 0000으로 나타내고 D 클래스라고 적습니다. D 클래스는 멀티캐스트 용도, E 클래스는 학술 연구용 예약 주소라고 기록합니다.\",\n      \"type\": {\n        \"category\": \"주소 체계\",\n        \"subtype\": \"클래스\"\n      }\n    },\n    {\n      \"name\": \"IPv4 8비트 옥텟\",\n      \"description\": \"자료는 IPv4의 옥텟을 8비트 구조로 제시하고 각 비트 값으로 128, 64, 32, 16, 8, 4, 2, 1을 나열합니다.\",\n      \"type\": {\n        \"category\": \"주소 체계\",\n        \"subtype\": \"비트 표현\"\n      }\n    }\n  ],\n  \"relationships\": null,\n  \"theory\": {\n    \"definitions\": [\n      {\n        \"subject\": \"SSH\",\n        \"content\": \"자료에서는 SSH를 암호문으로 통신하는 원격 접속용 프로토콜이라고 설명합니다.\",\n        \"evidence\": {\n          \"start_line\": 27,\n          \"end_line\": 28\n        }\n      },\n      {\n        \"subject\": \"IPv4 주소 클래스\",\n        \"content\": \"자료는 IPv4 주소를 MSB를 이용해 식별하는 5개 클래스로 구분한다고 설명합니다. D 클래스는 멀티캐스트 용도, E 클래스는 학술 연구용 예약 주소라고 적고 있습니다.\",\n        \"evidence\": {\n          \"start_line\": 65,\n          \"end_line\": 75\n        }\n      }\n    ],\n    \"principles\": [\n      {\n        \"subject\": \"SSH 구성 조건\",\n        \"content\": \"자료는 SSH 구성 조건으로 로컬 계정, 특권 암호, 도메인 지정, 암호화 알고리즘 선택 및 키 길이 지정, 가상 회선 범위를 열거합니다. R2 예시에는 로컬 계정, 도메인, 키 생성 도움말 명령, VTY 범위와 로컬 로그인 설정이 나타나며 키 생성 명령의 구체적인 값은 제시되지 않았습니다.\",\n        \"evidence\": {\n          \"start_line\": 29,\n          \"end_line\": 42\n        },\n        \"related_concepts\": [\n          \"SSH 구성 요소\",\n          \"SSH 원격 접속\"\n        ]\n      },\n      {\n        \"subject\": \"서브넷 마스크와 비트 표현\",\n        \"content\": \"자료는 192.168.1.1/24를 이진수로 나타내고 마스크 연산을 AND 연산으로 설명합니다. 이어 IPv4 옥텟의 비트 값과 서브넷 마스크를 통한 매핑을 기록합니다.\",\n        \"evidence\": {\n          \"start_line\": 49,\n          \"end_line\": 63\n        },\n        \"related_concepts\": [\n          \"IPv4 서브넷 마스크\",\n          \"IPv4 8비트 옥텟\"\n        ]\n      }\n    ],\n    \"comparisons\": null\n  },\n  \"practice\": [\n    {\n      \"title\": \"R1·R2 인터페이스 및 RIP 설정 예시\",\n      \"description\": \"R1과 R2에서 Fa0/0 및 S1/0에 각각 주소와 마스크를 설정하고 no shutdown을 입력한 뒤, router rip 아래에 네트워크를 지정하는 명령 예시입니다. 실행 여부나 라우팅 결과는 기록되지 않았습니다.\",\n      \"evidence\": {\n        \"start_line\": 1,\n        \"end_line\": 25\n      },\n      \"related_concepts\": [\n        \"라우터 인터페이스 IP 주소 설정\",\n        \"RIP 설정\"\n      ]\n    },\n    {\n      \"title\": \"R2 SSH 설정 및 R1 접속 명령 예시\",\n      \"description\": \"R2에서 특권 암호, 로컬 계정, 도메인, 키 생성 도움말 명령, VTY 범위와 로컬 로그인 설정을 제시하고 R1에서 R2 주소를 대상으로 SSH 접속 명령을 적었습니다. 접속 결과와 성공 여부는 기록되지 않았습니다.\",\n      \"evidence\": {\n        \"start_line\": 36,\n        \"end_line\": 45\n      },\n      \"related_concepts\": [\n        \"SSH 원격 접속\",\n        \"SSH 구성 요소\"\n      ]\n    }\n  ],\n  \"schema_version\": \"0.2\",\n  \"sections\": [\n    {\n      \"id\": \"router-setup\",\n      \"title\": \"R1·R2 인터페이스 및 RIP 설정\",\n      \"content_refs\": [\n        \"/concepts/0\",\n        \"/concepts/1\",\n        \"/practice/0\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"ssh-access\",\n      \"title\": \"SSH 구성과 접속 예시\",\n      \"content_refs\": [\n        \"/concepts/2\",\n        \"/concepts/3\",\n        \"/theory/definitions/0\",\n        \"/theory/principles/0\",\n        \"/practice/1\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"ipv4\",\n      \"title\": \"IPv4 서브넷 마스크, 비트 표현 및 클래스\",\n      \"content_refs\": [\n        \"/concepts/4\",\n        \"/concepts/5\",\n        \"/concepts/6\",\n        \"/theory/definitions/1\",\n        \"/theory/principles/1\"\n      ],\n      \"comment\": null\n    }\n  ],\n  \"review_candidates\": null\n}"
