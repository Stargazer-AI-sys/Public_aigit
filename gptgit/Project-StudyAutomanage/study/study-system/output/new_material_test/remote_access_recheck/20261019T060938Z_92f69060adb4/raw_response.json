"{\n  \"material_type\": {\n    \"material_type\": \"실습\",\n    \"confidence\": 0.83,\n    \"reason\": \"원격 접속을 위한 R2·R3의 설정 명령 예시가 중심이며, Telnet과 방화벽 관련 용어 메모도 함께 포함되어 있습니다. 명령 실행이나 접속 확인 결과는 제시되지 않았습니다.\"\n  },\n  \"summary\": \"Telnet 원격 접속에 관한 R2·R3 설정 명령과 방화벽·계층 관련 메모를 담고 있으며, 실행 결과는 확인되지 않습니다.\",\n  \"topics\": [\n    {\n      \"name\": \"네트워크 관리\",\n      \"children\": [\n        {\n          \"name\": \"원격 접속\",\n          \"children\": [\n            {\n              \"name\": \"Telnet 설정\",\n              \"children\": null\n            }\n          ]\n        },\n        {\n          \"name\": \"방화벽\",\n          \"children\": [\n            {\n              \"name\": \"2계층 방화벽 메모\",\n              \"children\": null\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"keywords\": [\n    {\n      \"name\": \"Telnet\",\n      \"type\": \"원격 접속\"\n    },\n    {\n      \"name\": \"TCP/23\",\n      \"type\": \"프로토콜 포트\"\n    },\n    {\n      \"name\": \"가상회선(VTY)\",\n      \"type\": \"장비 설정\"\n    },\n    {\n      \"name\": \"2계층 방화벽\",\n      \"type\": \"방화벽\"\n    },\n    {\n      \"name\": \"Message\",\n      \"type\": \"계층 관련 용어 메모\"\n    },\n    {\n      \"name\": \"Segment\",\n      \"type\": \"계층 관련 용어 메모\"\n    },\n    {\n      \"name\": \"Packet\",\n      \"type\": \"계층 관련 용어 메모\"\n    },\n    {\n      \"name\": \"Frame\",\n      \"type\": \"계층 관련 용어 메모\"\n    }\n  ],\n  \"concepts\": [\n    {\n      \"name\": \"Telnet\",\n      \"description\": \"자료는 Telnet이 TCP 23번을 사용한다고 적고, R2와 R3에서 VTY 회선 범위 및 암호 관련 명령을 입력하는 설정 예시를 제시합니다. 명령의 실행이나 원격 접속 성공 여부는 확인되지 않습니다.\",\n      \"type\": {\n        \"category\": \"네트워크 관리\",\n        \"subtype\": \"원격 접속\"\n      }\n    },\n    {\n      \"name\": \"가상회선(VTY)\",\n      \"description\": \"R2에는 `line vty 0 2`, R3에는 `line vty 0 1` 설정 예시가 있습니다. 자료는 가상회선 범위와 접속 암호를 구성 항목으로 나열하지만, 설정 결과나 접속 여부는 제시하지 않습니다.\",\n      \"type\": {\n        \"category\": \"네트워크 관리\",\n        \"subtype\": \"장비 설정\"\n      }\n    },\n    {\n      \"name\": \"2계층 방화벽 메모\",\n      \"description\": \"자료에는 '방화벽 장비'와 '2계층 방화벽'이라는 메모가 있으나, 기능이나 구성에 관한 설명은 없습니다.\",\n      \"type\": {\n        \"category\": \"네트워크 보안\",\n        \"subtype\": \"방화벽\"\n      }\n    },\n    {\n      \"name\": \"Message·Segment·Packet·Frame 메모\",\n      \"description\": \"자료에 네 용어가 나열되어 있지만, 서로의 관계나 계층별 대응을 설명하지 않습니다.\",\n      \"type\": {\n        \"category\": \"네트워크 기초\",\n        \"subtype\": \"계층 관련 용어 메모\"\n      }\n    }\n  ],\n  \"relationships\": null,\n  \"theory\": {\n    \"definitions\": null,\n    \"principles\": null,\n    \"comparisons\": null\n  },\n  \"practice\": [\n    {\n      \"title\": \"R2·R3 Telnet 원격 접속 설정 예시\",\n      \"description\": \"R2에서는 설정 모드 진입 후 특권 암호 설정 명령과 VTY 0–2 범위 및 암호 입력 예시를, R3에서는 설정 모드 진입 후 특권 암호 명령과 VTY 0–1 범위 및 암호 입력 예시를 제시합니다. 실행 여부나 원격 접속 확인 결과는 기록되어 있지 않습니다.\",\n      \"evidence\": {\n        \"start_line\": 7,\n        \"end_line\": 16\n      },\n      \"related_concepts\": [\n        \"Telnet\",\n        \"가상회선(VTY)\"\n      ]\n    }\n  ],\n  \"schema_version\": \"0.2\",\n  \"sections\": [\n    {\n      \"id\": \"telnet-remote-access\",\n      \"title\": \"Telnet 원격 접속 설정 예시\",\n      \"content_refs\": [\n        \"/concepts/0\",\n        \"/concepts/1\",\n        \"/practice/0\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"firewall-and-layer-terms\",\n      \"title\": \"방화벽 및 계층 관련 용어 메모\",\n      \"content_refs\": [\n        \"/concepts/2\",\n        \"/concepts/3\"\n      ],\n      \"comment\": null\n    }\n  ],\n  \"review_candidates\": null\n}"
