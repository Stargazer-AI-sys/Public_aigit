"{\n  \"material_type\": {\n    \"material_type\": \"실습\",\n    \"confidence\": 0.84,\n    \"reason\": \"라우터 인터페이스와 RIP 또는 정적 경로를 설정하는 절차가 중심이며, 라우팅 관련 개념 설명과 확인 명령도 함께 포함되어 있습니다. 설정 결과나 확인 출력은 제시되지 않습니다.\"\n  },\n  \"summary\": \"라우팅 테이블과 정적·동적 라우팅을 설명하고, 세 라우터의 인터페이스 및 경로 설정 예시를 제시합니다.\",\n  \"topics\": [\n    {\n      \"name\": \"네트워크 라우팅\",\n      \"children\": [\n        {\n          \"name\": \"라우팅 개념 및 테이블\",\n          \"children\": null\n        },\n        {\n          \"name\": \"라우터 인터페이스 구성\",\n          \"children\": null\n        },\n        {\n          \"name\": \"정적·동적 라우팅 구성\",\n          \"children\": null\n        },\n        {\n          \"name\": \"라우팅 확인\",\n          \"children\": null\n        }\n      ]\n    }\n  ],\n  \"keywords\": [\n    {\n      \"name\": \"라우팅 테이블\",\n      \"type\": \"테이블\"\n    },\n    {\n      \"name\": \"Topology Database\",\n      \"type\": \"데이터베이스\"\n    },\n    {\n      \"name\": \"Packet Switching\",\n      \"type\": \"라우터 기능\"\n    },\n    {\n      \"name\": \"Path Selection\",\n      \"type\": \"라우터 기능\"\n    },\n    {\n      \"name\": \"정적 라우팅\",\n      \"type\": \"라우팅 방식\"\n    },\n    {\n      \"name\": \"동적 라우팅\",\n      \"type\": \"라우팅 방식\"\n    },\n    {\n      \"name\": \"RIP\",\n      \"type\": \"라우팅 프로토콜\"\n    },\n    {\n      \"name\": \"show ip route\",\n      \"type\": \"확인 명령\"\n    }\n  ],\n  \"concepts\": [\n    {\n      \"name\": \"라우팅 테이블\",\n      \"description\": \"자료에서는 라우팅 테이블이 최적의 경로 정보만 저장하며, 가능한 나머지 정보는 Topology Database에 저장된다고 설명합니다.\",\n      \"type\": {\n        \"category\": \"네트워크 구성요소\",\n        \"subtype\": \"라우터 정보\"\n      }\n    },\n    {\n      \"name\": \"Topology Database\",\n      \"description\": \"자료에서 라우팅 테이블에 저장되지 않는 가능한 나머지 경로 정보가 저장되는 곳으로 제시됩니다.\",\n      \"type\": {\n        \"category\": \"네트워크 구성요소\",\n        \"subtype\": \"데이터베이스\"\n      }\n    },\n    {\n      \"name\": \"Packet Switching\",\n      \"description\": \"자료에서 라우터가 패킷을 보낼지 말지를 결정하는 기능으로 설명합니다.\",\n      \"type\": {\n        \"category\": \"네트워크 기능\",\n        \"subtype\": \"라우터 기능\"\n      }\n    },\n    {\n      \"name\": \"Path Selection\",\n      \"description\": \"자료에서 패킷을 보내기로 했을 때 어떤 인터페이스로 보낼지 결정하는 기능으로 설명합니다.\",\n      \"type\": {\n        \"category\": \"네트워크 기능\",\n        \"subtype\": \"라우터 기능\"\n      }\n    },\n    {\n      \"name\": \"정적 라우팅\",\n      \"description\": \"자료에서는 관리자가 원격지 네트워크를 직접 지정하는 라우팅 방식으로 설명하고, ip route 명령으로 원격 네트워크와 마스크 및 출력 인터페이스를 지정하는 예시를 제시합니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"정적\"\n      }\n    },\n    {\n      \"name\": \"동적 라우팅\",\n      \"description\": \"자료에서는 라우터 간 정보 교환을 통해 경로를 학습하는 방식으로 설명합니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"동적\"\n      }\n    },\n    {\n      \"name\": \"RIP\",\n      \"description\": \"자료에는 router rip 설정 모드에서 net 명령으로 R1, R2, R3의 네트워크를 지정하는 구성 예시가 있습니다. 실행 결과는 제시되지 않습니다.\",\n      \"type\": {\n        \"category\": \"라우팅 프로토콜\",\n        \"subtype\": \"동적 라우팅\"\n      }\n    },\n    {\n      \"name\": \"라우터 인터페이스 IP 설정\",\n      \"description\": \"R1, R2, R3의 FastEthernet 및 Serial 인터페이스에 IP 주소와 서브넷 마스크를 지정하고 no shut 또는 no sh를 입력하는 설정 예시가 있습니다.\",\n      \"type\": {\n        \"category\": \"네트워크 구성\",\n        \"subtype\": \"인터페이스 설정\"\n      }\n    },\n    {\n      \"name\": \"라우팅 상태 확인 명령\",\n      \"description\": \"자료는 do sh ip int b를 전체 인터페이스 상태 확인 명령으로, do sh ip route를 라우팅 테이블 확인 명령으로 제시합니다.\",\n      \"type\": {\n        \"category\": \"네트워크 운영\",\n        \"subtype\": \"확인 명령\"\n      }\n    },\n    {\n      \"name\": \"PC IP 및 게이트웨이 설정\",\n      \"description\": \"PC1에 IP 주소 192.168.1.1, 마스크 255.255.255.0, 게이트웨이 192.168.1.254를 지정하는 예시가 있습니다.\",\n      \"type\": {\n        \"category\": \"네트워크 구성\",\n        \"subtype\": \"호스트 설정\"\n      }\n    }\n  ],\n  \"relationships\": [\n    {\n      \"from\": \"정적 라우팅\",\n      \"relation\": \"관리자가 직접 지정하는 방식이다\",\n      \"to\": \"라우팅 테이블\",\n      \"description\": \"자료는 정적 라우팅을 원격지 네트워크를 관리자가 직접 지정하는 방식으로 설명하고, 라우팅 테이블 확인 명령도 제시합니다.\"\n    },\n    {\n      \"from\": \"동적 라우팅\",\n      \"relation\": \"라우터 간 정보 교환을 통해 경로를 학습한다\",\n      \"to\": \"라우팅 테이블\",\n      \"description\": \"자료는 동적 라우팅의 경로 학습을 설명하고 라우팅 테이블을 경로 정보가 저장되는 대상으로 제시합니다.\"\n    },\n    {\n      \"from\": \"RIP\",\n      \"relation\": \"자료에서 동적 라우팅 구성 예시로 사용된다\",\n      \"to\": \"동적 라우팅\",\n      \"description\": \"R1, R2, R3에서 router rip 및 net 명령을 사용하는 예시가 제시됩니다.\"\n    }\n  ],\n  \"theory\": {\n    \"definitions\": [\n      {\n        \"subject\": \"라우팅 테이블\",\n        \"content\": \"자료에서는 라우팅 테이블에 최적의 경로 정보만 저장되고, 가능한 나머지 정보는 Topology Database에 저장된다고 설명합니다.\",\n        \"evidence\": {\n          \"start_line\": 20,\n          \"end_line\": 23\n        }\n      },\n      {\n        \"subject\": \"정적 라우팅과 동적 라우팅\",\n        \"content\": \"자료에서는 정적 라우팅을 관리자가 원격지 네트워크를 직접 지정하는 방식으로, 동적 라우팅을 라우터 간 정보 교환으로 학습하는 방식으로 구분합니다.\",\n        \"evidence\": {\n          \"start_line\": 16,\n          \"end_line\": 18\n        }\n      },\n      {\n        \"subject\": \"라우터 핵심 기능\",\n        \"content\": \"자료는 Packet Switching을 패킷 전송 여부 결정으로, Path Selection을 전송 인터페이스 결정으로 설명합니다.\",\n        \"evidence\": {\n          \"start_line\": 12,\n          \"end_line\": 14\n        }\n      }\n    ],\n    \"principles\": null,\n    \"comparisons\": [\n      {\n        \"subject_a\": \"정적 라우팅\",\n        \"subject_b\": \"동적 라우팅\",\n        \"criteria\": [\n          \"경로 지정 주체 또는 방법: 관리자가 직접 지정 / 라우터 간 정보 교환으로 학습\"\n        ],\n        \"evidence\": {\n          \"start_line\": 16,\n          \"end_line\": 18\n        },\n        \"related_concepts\": [\n          \"정적 라우팅\",\n          \"동적 라우팅\"\n        ]\n      }\n    ]\n  },\n  \"practice\": [\n    {\n      \"title\": \"라우터 인터페이스 IP 설정\",\n      \"description\": \"R1에는 Fa0/0에 192.168.1.254/24, S1/0에 192.168.12.1/24를 설정합니다. R2에는 S1/1에 192.168.12.2/24, S1/2에 192.168.23.1/24, Fa0/0에 192.168.2.254/24를 설정합니다. R3에는 S1/3에 192.168.23.2/24, Fa0/0에 192.168.3.254/24를 설정합니다. 각 인터페이스에 no shut 또는 no sh를 입력하는 예시이며, 수행 결과는 확인되지 않습니다.\",\n      \"evidence\": {\n        \"start_line\": 26,\n        \"end_line\": 53\n      },\n      \"related_concepts\": [\n        \"라우터 인터페이스 IP 설정\"\n      ]\n    },\n    {\n      \"title\": \"RIP 네트워크 지정 예시\",\n      \"description\": \"R1은 192.168.1.0과 192.168.12.0, R2는 192.168.2.0·192.168.12.0·192.168.23.0, R3는 192.168.23.0과 192.168.3.0을 router rip 설정에서 지정합니다. 이는 설정 예시이며 동작 결과는 제시되지 않습니다.\",\n      \"evidence\": {\n        \"start_line\": 63,\n        \"end_line\": 81\n      },\n      \"related_concepts\": [\n        \"RIP\",\n        \"동적 라우팅\"\n      ]\n    },\n    {\n      \"title\": \"정적 경로 지정 예시\",\n      \"description\": \"R1은 192.168.2.0/24와 192.168.3.0/24 경로를 S1/0으로, R2는 192.168.1.0/24를 S1/1로 및 192.168.3.0/24를 S1/2로, R3는 192.168.1.0/24와 192.168.2.0/24를 S1/3으로 지정하는 ip route 명령 예시를 제시합니다. R1 설정 뒤에는 라우팅 테이블 확인 명령이 있으나 출력 결과는 없습니다.\",\n      \"evidence\": {\n        \"start_line\": 83,\n        \"end_line\": 98\n      },\n      \"related_concepts\": [\n        \"정적 라우팅\",\n        \"라우팅 상태 확인 명령\"\n      ]\n    },\n    {\n      \"title\": \"인터페이스·라우팅 테이블 확인 명령\",\n      \"description\": \"자료는 do sh ip int b로 전체 인터페이스 상태를 확인하고 do sh ip route로 라우팅 테이블을 확인하도록 안내합니다. 실제 명령 실행 결과는 제시되지 않습니다.\",\n      \"evidence\": {\n        \"start_line\": 55,\n        \"end_line\": 61\n      },\n      \"related_concepts\": [\n        \"라우팅 상태 확인 명령\",\n        \"라우팅 테이블\"\n      ]\n    },\n    {\n      \"title\": \"PC1 IP 및 게이트웨이 설정 예시\",\n      \"description\": \"PC1에 IP 주소 192.168.1.1, 서브넷 마스크 255.255.255.0, 게이트웨이 192.168.1.254를 설정하는 예시입니다. 설정 수행 결과는 제시되지 않습니다.\",\n      \"evidence\": {\n        \"start_line\": 100,\n        \"end_line\": 101\n      },\n      \"related_concepts\": [\n        \"PC IP 및 게이트웨이 설정\"\n      ]\n    }\n  ],\n  \"schema_version\": \"0.2\",\n  \"sections\": [\n    {\n      \"id\": \"routing-concepts\",\n      \"title\": \"라우팅 개념과 테이블\",\n      \"content_refs\": [\n        \"/concepts/0\",\n        \"/concepts/1\",\n        \"/concepts/2\",\n        \"/concepts/3\",\n        \"/concepts/4\",\n        \"/concepts/5\",\n        \"/concepts/6\",\n        \"/relationships/0\",\n        \"/relationships/1\",\n        \"/relationships/2\",\n        \"/theory/definitions/0\",\n        \"/theory/definitions/1\",\n        \"/theory/definitions/2\",\n        \"/theory/comparisons/0\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"router-interface-setup\",\n      \"title\": \"라우터 인터페이스 구성\",\n      \"content_refs\": [\n        \"/concepts/7\",\n        \"/practice/0\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"routing-configuration\",\n      \"title\": \"RIP 및 정적 경로 구성\",\n      \"content_refs\": [\n        \"/practice/1\",\n        \"/practice/2\"\n      ],\n      \"comment\": null\n    },\n    {\n      \"id\": \"routing-verification-and-host\",\n      \"title\": \"라우팅 확인 및 PC 설정\",\n      \"content_refs\": [\n        \"/concepts/8\",\n        \"/concepts/9\",\n        \"/practice/3\",\n        \"/practice/4\"\n      ],\n      \"comment\": null\n    }\n  ],\n  \"review_candidates\": null\n}"
