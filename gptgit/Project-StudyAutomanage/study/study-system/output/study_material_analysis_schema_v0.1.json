{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-material-analysis-v0.1",
  "title": "Study Material AI Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "material_type",
    "summary"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "filename",
        "extension"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9]+$"
        }
      }
    },
    "material_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_type",
        "confidence",
        "reason"
      ],
      "properties": {
        "material_type": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/keyword"
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "theory": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/principle"
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparison"
          }
        }
      }
    },
    "practice": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/practice"
      }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/topic"
          }
        }
      }
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "subtype"
          ],
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "subtype": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "relation",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "content",
        "evidence"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "content",
        "evidence"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_a",
        "subject_b",
        "criteria",
        "evidence"
      ],
      "properties": {
        "subject_a": {
          "type": "string",
          "minLength": 1
        },
        "subject_b": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "related_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}