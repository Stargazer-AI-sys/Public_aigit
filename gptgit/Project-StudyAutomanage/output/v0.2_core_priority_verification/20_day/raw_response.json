"{\n  \"material_type\": {\n    \"material_type\": \"실습\",\n    \"confidence\": 0.88,\n    \"reason\": \"SVI와 라우팅·경로 재분배의 설정 및 확인 절차가 중심이며, 경로 재분배의 설명과 라우팅 테이블 관찰 기록도 포함합니다.\"\n  },\n  \"summary\": \"SVI를 통한 VLAN 라우팅, 루프백을 이용한 핑 테스트, RIP 정적 경로 재분배의 설정과 확인을 다룹니다.\",\n  \"topics\": [\n    {\n      \"name\": \"L3 스위치 라우팅\",\n      \"children\": [\n        {\n          \"name\": \"SVI를 이용한 Inter-VLAN\"\n        }\n      ]\n    },\n    {\n      \"name\": \"루프백 주소를 소스로 지정한 핑\"\n    },\n    {\n      \"name\": \"경로 재분배\",\n      \"children\": [\n        {\n          \"name\": \"RIP 정적 경로 재분배\"\n        }\n      ]\n    }\n  ],\n  \"keywords\": [\n    {\n      \"name\": \"SVI\",\n      \"type\": \"네트워크 인터페이스\"\n    },\n    {\n      \"name\": \"Inter-VLAN\",\n      \"type\": \"라우팅\"\n    },\n    {\n      \"name\": \"IGP\",\n      \"type\": \"라우팅 프로토콜 분류\"\n    },\n    {\n      \"name\": \"EGP\",\n      \"type\": \"라우팅 프로토콜 분류\"\n    },\n    {\n      \"name\": \"경로 재분배\",\n      \"type\": \"라우팅\"\n    },\n    {\n      \"name\": \"RIP\",\n      \"type\": \"동적 라우팅 프로토콜\"\n    },\n    {\n      \"name\": \"루프백 인터페이스\",\n      \"type\": \"가상 인터페이스\"\n    }\n  ],\n  \"concepts\": [\n    {\n      \"name\": \"SVI\",\n      \"description\": \"VLAN에 IP 주소를 설정해 L3 스위치에서 VLAN 간 라우팅에 사용하는 인터페이스입니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"가상 인터페이스\"\n      }\n    },\n    {\n      \"name\": \"Inter-VLAN 라우팅\",\n      \"description\": \"서로 다른 VLAN 사이에서 이루어지는 라우팅이며, 자료는 SVI를 이용하는 구성을 다룹니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"라우팅\"\n      }\n    },\n    {\n      \"name\": \"루프백 인터페이스\",\n      \"description\": \"자료에서 가상의 장비를 추가하는 용도로 언급하며, 핑 테스트의 소스 IP로 사용합니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"가상 인터페이스\"\n      }\n    },\n    {\n      \"name\": \"경로 재분배\",\n      \"description\": \"서로 다른 라우팅 프로토콜을 사용하는 네트워크 간에 경로 정보를 번역하고 공유하는 기능입니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"라우팅 기능\"\n      }\n    },\n    {\n      \"name\": \"RIP\",\n      \"description\": \"자료에서 경로 재분배 대상 프로토콜로 사용되며, 정적 경로를 재분배하는 설정 예가 제시됩니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"동적 라우팅 프로토콜\"\n      }\n    },\n    {\n      \"name\": \"정적 경로\",\n      \"description\": \"자료에서는 기본 경로와 특정 네트워크 경로를 설정한 뒤 RIP로 재분배하는 대상으로 다룹니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"라우팅 경로\"\n      }\n    },\n    {\n      \"name\": \"트렁크 포트\",\n      \"description\": \"스위치 포트를 트렁크 모드로 설정하고 상태를 확인하도록 안내하는 예시다. 상태 확인 출력은 기록되어 있지 않다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"스위치 포트\"\n      }\n    }\n  ],\n  \"relationships\": [\n    {\n      \"from\": \"SVI\",\n      \"relation\": \"사용하여 구성\",\n      \"to\": \"Inter-VLAN 라우팅\",\n      \"description\": \"자료는 SVI를 이용한 Inter-VLAN 구성을 다룹니다.\"\n    },\n    {\n      \"from\": \"정적 경로\",\n      \"relation\": \"RIP로 재분배\",\n      \"to\": \"RIP\",\n      \"description\": \"R1에서 정적 경로를 RIP로 재분배하는 설정이 제시됩니다.\"\n    }\n  ],\n  \"theory\": {\n    \"definitions\": [\n      {\n        \"subject\": \"경로 재분배\",\n        \"content\": \"서로 다른 라우팅 프로토콜을 사용하는 네트워크 간에 경로 정보를 번역하고 공유하여 한쪽 프로토콜이 학습한 네트워크 정보를 다른 쪽 프로토콜로 전달하는 기능이라고 설명합니다.\",\n        \"evidence\": \"[경로 재분배]:서로 다른 라우팅 프로토콜(예: OSPF, EIGRP, RIP, BGP 등)을 사용하는 네트워크 간에 경로 정보를 번역하고 공유하여, 한쪽 프로토콜이 학습한 네트워크 정보를 다른 쪽 프로토콜로 전달하는 기능입니다.\"\n      }\n    ],\n    \"principles\": [\n      {\n        \"subject\": \"RIP 정적 경로 재분배\",\n        \"content\": \"자료에서는 RIP에 정적 경로를 재분배할 때 메트릭을 10으로 지정하는 설정 예를 제시합니다.\",\n        \"evidence\": \"redistribute static metric 10 #RIP의 메트릭값을 10으로 재분배\",\n        \"related_concepts\": [\n          \"정적 경로\",\n          \"RIP\"\n        ]\n      },\n      {\n        \"subject\": \"경로 재분배의 적용 구간\",\n        \"content\": \"자료에서는 경로 재분배를 동적 라우팅 프로토콜로 연결된 구간에서 사용하며, 정적으로 연결된 라우터 간에는 사용하지 않는다고 설명합니다.\",\n        \"evidence\": \"***경로 재분배는 동적 라우팅 프로토콜로 연결된 구간에서 사용가능.\\n-정적으로 연결된 라우터간에는 사용안함\",\n        \"related_concepts\": [\n          \"경로 재분배\",\n          \"RIP\",\n          \"정적 경로\"\n        ]\n      },\n      {\n        \"subject\": \"루프백 주소를 소스로 지정한 핑\",\n        \"content\": \"자료에서는 루프백 인터페이스를 가상 장비로 추가한 경우 확장 핑에 소스 IP를 기입해야 한다고 설명합니다. 예시 명령만 제시되어 있어 핑 성공 여부는 확인되지 않습니다.\",\n        \"evidence\": \"루프백 인터페이스로 가상의 장비를 추가했을때 핑테스트는\\nR1#ping 192.168.10.1 source 192.168.30.1\\n확장핑으로 소스 아이피를 기입해야된다.\",\n        \"related_concepts\": [\n          \"루프백 인터페이스\"\n        ]\n      }\n    ]\n  },\n  \"practice\": [\n    {\n      \"title\": \"L3 스위치의 SVI 및 트렁크 구성 확인\",\n      \"description\": \"스위치 포트를 VLAN에 할당하고 트렁크를 설정한 뒤, trunk 상태와 VLAN 인터페이스의 IP 및 활성화 여부를 확인하도록 안내합니다. 결과 출력은 기재되지 않았습니다.\",\n      \"evidence\": \"aSw1\\nconf t\\nint fa1/1\\nsw mode acc\\nsw acc vlan 10\\nint fa1/2\\nsw mo acc\\nsw acc vlan 20\\nint fa1/15\\nsw mo tr\\n\\nsh vlan-switch\\n\\n ASW2\\nconf t\\nint fa1/1\\nsw mode acc\\nsw acc vlan 10\\nint fa1/2\\nsw mo acc\\nsw acc vlan 20\\nint range fa1/14 - 15\\nsw mo tr\\n\\nconf t\\nip routing\\nvlan 10\\nint vlan 10\\nip addr 192.168.10.254 255.255.255.0\\nvlan 20\\nint vlan 20\\nip addr 192.168.20.254 255.255.255.0\\nin fa1/14\\nsw mo tr\\n\\n설정 후 2가지 확인\\n1. sh int trunk : fa0/14포트가 trunk로 지정되어 있는지, 캡슐화 프로토콜은 무엇인지 확인\\n2. sh ip int b : vlan 10, vlan 20에 할당된 IP 및 SVI 활성화 여부 확인\",\n      \"related_concepts\": [\n        \"SVI\",\n        \"Inter-VLAN 라우팅\",\n        \"트렁크 포트\"\n      ]\n    },\n    {\n      \"title\": \"루프백 인터페이스를 소스로 지정한 핑 테스트\",\n      \"description\": \"루프백 주소를 소스 IP로 지정해 핑을 실행하는 명령 예가 있습니다. 핑 결과는 원문에 제시되지 않아 성공 여부를 확인할 수 없습니다.\",\n      \"evidence\": \"R1#ping 192.168.10.1 source 192.168.30.1\",\n      \"related_concepts\": [\n        \"루프백 인터페이스\"\n      ]\n    },\n    {\n      \"title\": \"RIP 정적 경로 재분배 설정 및 라우팅 테이블 확인\",\n      \"description\": \"R1에서 정적 경로를 RIP로 재분배하는 명령을 제시합니다. 이어서 학습되지 않은 ESW3의 라우팅 테이블에 192.168.40.0/24 경로가 표시된 관찰 기록이 있으며, 이 기록의 설정과 장비 간 연결 원인은 별도로 확정하지 않습니다.\",\n      \"evidence\": \"R1\\nrouter rip\\nredistribute static metric 10 #RIP의 메트릭값을 10으로 재분배\\n#redistribute connected  #직접 연결된 네트워크 재분배\\n\\n 설정 하면  \\n\\n학습이 되지 않은 ESW3\\n\\nR    192.168.40.0/24 [120/10] via 172.16.12.2, 00:00:21, FastEthernet1/1\\n     172.16.0.0/30 is subnetted, 1 subnets\\n\\n라우팅 테이블에 위와 같이 나온다.\",\n      \"related_concepts\": [\n        \"경로 재분배\",\n        \"RIP\",\n        \"정적 경로\"\n      ]\n    }\n  ],\n  \"schema_version\": \"0.2-draft\",\n  \"sections\": [\n    {\n      \"id\": \"svi-trunks\",\n      \"title\": \"SVI와 트렁크 구성\",\n      \"content_refs\": [\n        \"/concepts/0\",\n        \"/concepts/1\",\n        \"/concepts/6\",\n        \"/relationships/0\",\n        \"/practice/0\"\n      ]\n    },\n    {\n      \"id\": \"loopback-ping\",\n      \"title\": \"루프백 주소를 소스로 지정한 핑\",\n      \"content_refs\": [\n        \"/concepts/2\",\n        \"/theory/principles/2\",\n        \"/practice/1\"\n      ]\n    },\n    {\n      \"id\": \"static-redistribution\",\n      \"title\": \"정적 경로의 RIP 재분배\",\n      \"content_refs\": [\n        \"/concepts/3\",\n        \"/concepts/4\",\n        \"/concepts/5\",\n        \"/relationships/1\",\n        \"/theory/definitions/0\",\n        \"/theory/principles/0\",\n        \"/theory/principles/1\",\n        \"/practice/2\"\n      ]\n    }\n  ],\n  \"source\": {\n    \"material_id\": \"bc311d69fc2366ebe3ae69a6b0b4627fd79e437b96c97241398ba20313aacf4d\",\n    \"filename\": \"20일차 경로재분배,루프백가상장비설정.txt\",\n    \"extension\": \".txt\"\n  }\n}\n"
