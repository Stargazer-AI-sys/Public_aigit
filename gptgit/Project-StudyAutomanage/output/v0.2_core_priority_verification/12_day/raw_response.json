"{\n  \"material_type\": {\n    \"material_type\": \"실습\",\n    \"confidence\": 0.86,\n    \"reason\": \"라우팅 개념 복습과 정적·동적 라우팅 및 플로팅 라우트 명령 예시가 함께 있는 실습 중심 혼합 자료다. 타임아웃·핑 성공이 번갈아 적힌 관찰 메모가 있으나 관련 장비·구성과의 연결 근거는 불충분하다.\"\n  },\n  \"summary\": \"라우팅의 기본 기능과 경로 선택 기준을 복습하고, 정적·동적 라우팅 및 디폴트·플로팅 라우트 설정을 다룹니다.\",\n  \"topics\": [\n    {\n      \"name\": \"라우팅 기본 개념\",\n      \"children\": [\n        {\n          \"name\": \"라우터 기능\"\n        },\n        {\n          \"name\": \"네트워크 분리\"\n        }\n      ]\n    },\n    {\n      \"name\": \"라우팅 프로토콜\",\n      \"children\": [\n        {\n          \"name\": \"IGP와 EGP\"\n        },\n        {\n          \"name\": \"경로 계산 방식\"\n        }\n      ]\n    },\n    {\n      \"name\": \"정적 라우팅\",\n      \"children\": [\n        {\n          \"name\": \"디폴트 라우트와 stub network\"\n        },\n        {\n          \"name\": \"경로 선택 기준\"\n        },\n        {\n          \"name\": \"플로팅 라우트\"\n        }\n      ]\n    },\n    {\n      \"name\": \"동적 라우팅\",\n      \"children\": [\n        {\n          \"name\": \"RIP 설정\"\n        }\n      ]\n    }\n  ],\n  \"keywords\": [\n    {\n      \"name\": \"라우팅 테이블\",\n      \"type\": \"자료 구조\"\n    },\n    {\n      \"name\": \"packet switching\",\n      \"type\": \"라우터 기능\"\n    },\n    {\n      \"name\": \"path selection\",\n      \"type\": \"라우터 기능\"\n    },\n    {\n      \"name\": \"IGP\",\n      \"type\": \"라우팅 프로토콜\"\n    },\n    {\n      \"name\": \"EGP\",\n      \"type\": \"라우팅 프로토콜\"\n    },\n    {\n      \"name\": \"distance vector\",\n      \"type\": \"경로 계산 방식\"\n    },\n    {\n      \"name\": \"link state\",\n      \"type\": \"경로 계산 방식\"\n    },\n    {\n      \"name\": \"AD\",\n      \"type\": \"경로 선택 기준\"\n    },\n    {\n      \"name\": \"longest prefix\",\n      \"type\": \"경로 선택 기준\"\n    },\n    {\n      \"name\": \"stub network\",\n      \"type\": \"네트워크 유형\"\n    },\n    {\n      \"name\": \"floating route\",\n      \"type\": \"정적 라우팅\"\n    }\n  ],\n  \"concepts\": [\n    {\n      \"name\": \"라우팅\",\n      \"description\": \"라우팅 테이블을 기준으로 패킷을 특정 인터페이스로 출력하는 과정으로 설명됩니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"기능\"\n      }\n    },\n    {\n      \"name\": \"라우팅 테이블\",\n      \"description\": \"경로 매핑과 경로 선택에 사용되는 테이블입니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"자료 구조\"\n      }\n    },\n    {\n      \"name\": \"라우터 기능\",\n      \"description\": \"패킷 스위칭과 경로 선택을 핵심 기능으로 제시합니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"기능\"\n      }\n    },\n    {\n      \"name\": \"패킷 스위칭\",\n      \"description\": \"자료에서는 패킷을 보낼지 말지를 결정하는 기능으로 설명합니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"라우터 기능\"\n      }\n    },\n    {\n      \"name\": \"경로 선택\",\n      \"description\": \"목적지로 향하는 경로를 선택하는 기능입니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"라우터 기능\"\n      }\n    },\n    {\n      \"name\": \"Routed protocol 구성\",\n      \"description\": \"인터페이스에 IP를 설정하여 직접 연결된 네트워크를 구성하는 단계입니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"설정\"\n      }\n    },\n    {\n      \"name\": \"Routing protocol 구성\",\n      \"description\": \"원격지 네트워크를 학습하기 위한 라우팅 프로토콜 구성입니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"설정\"\n      }\n    },\n    {\n      \"name\": \"IGP\",\n      \"description\": \"하나의 AS 안에서 사용하는 라우팅 프로토콜 분류입니다.\",\n      \"type\": {\n        \"category\": \"라우팅 프로토콜\",\n        \"subtype\": \"내부\"\n      }\n    },\n    {\n      \"name\": \"EGP\",\n      \"description\": \"서로 다른 AS 사이에서 사용하는 라우팅 프로토콜 분류입니다.\",\n      \"type\": {\n        \"category\": \"라우팅 프로토콜\",\n        \"subtype\": \"외부\"\n      }\n    },\n    {\n      \"name\": \"Distance vector\",\n      \"description\": \"자료에서는 주기적으로 정보를 교환하는 경로 계산 방식으로 설명하며 RIP을 예로 듭니다.\",\n      \"type\": {\n        \"category\": \"라우팅 알고리즘\",\n        \"subtype\": \"거리 벡터\"\n      }\n    },\n    {\n      \"name\": \"Link state\",\n      \"description\": \"자료에서는 네트워크 상태가 변했을 때 정보를 교환하는 방식으로 설명하며 OSPF를 예로 듭니다.\",\n      \"type\": {\n        \"category\": \"라우팅 알고리즘\",\n        \"subtype\": \"링크 상태\"\n      }\n    },\n    {\n      \"name\": \"Hybrid\",\n      \"description\": \"자료에서는 distance vector와 link state의 혼합 방식으로 설명하며 EIGRP를 예로 듭니다.\",\n      \"type\": {\n        \"category\": \"라우팅 알고리즘\",\n        \"subtype\": \"혼합 방식\"\n      }\n    },\n    {\n      \"name\": \"정적 라우팅\",\n      \"description\": \"관리자가 원격지 네트워크 정보와 다음 홉 IP 또는 출력 인터페이스를 지정하는 방식입니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"정적\"\n      }\n    },\n    {\n      \"name\": \"디폴트 라우트\",\n      \"description\": \"자료에서는 불특정 다수와 통신하는 경우 등에 사용하는 기본 경로 방식으로 제시합니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"정적 경로\"\n      }\n    },\n    {\n      \"name\": \"Stub network\",\n      \"description\": \"자료에서는 외부와 통하는 인터페이스가 단 1개인 네트워크로 정의합니다.\",\n      \"type\": {\n        \"category\": \"네트워크\",\n        \"subtype\": \"토폴로지\"\n      }\n    },\n    {\n      \"name\": \"Longest prefix\",\n      \"description\": \"여러 경로가 적용될 때 프리픽스 길이가 긴 경로를 우선하는 기준으로 제시합니다.\",\n      \"type\": {\n        \"category\": \"경로 선택\",\n        \"subtype\": \"프리픽스 비교\"\n      }\n    },\n    {\n      \"name\": \"AD\",\n      \"description\": \"자료에서는 같은 네트워크 정보를 둘 이상의 경로로 학습했을 때 우선 경로를 판단하는 관리 거리로 설명합니다.\",\n      \"type\": {\n        \"category\": \"경로 선택\",\n        \"subtype\": \"관리 거리\"\n      }\n    },\n    {\n      \"name\": \"Cost\",\n      \"description\": \"자료에서는 경로 선택 시 낮은 비용을 우선하는 기준으로 제시합니다.\",\n      \"type\": {\n        \"category\": \"경로 선택\",\n        \"subtype\": \"비용\"\n      }\n    },\n    {\n      \"name\": \"동적 라우팅\",\n      \"description\": \"라우팅 프로토콜을 사용하여 원격지 네트워크를 학습하는 방식입니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"동적\"\n      }\n    },\n    {\n      \"name\": \"RIP\",\n      \"description\": \"자료에서 distance vector 방식의 라우팅 프로토콜 예로 제시되며 설정 명령도 포함됩니다.\",\n      \"type\": {\n        \"category\": \"라우팅 프로토콜\",\n        \"subtype\": \"IGP\"\n      }\n    },\n    {\n      \"name\": \"Floating route\",\n      \"description\": \"주 경로에 장애가 발생했을 때 보조 경로가 동작하도록 AD 등을 이용해 구성하는 경로입니다.\",\n      \"type\": {\n        \"category\": \"라우팅\",\n        \"subtype\": \"백업 경로\"\n      }\n    }\n  ],\n  \"relationships\": [\n    {\n      \"from\": \"라우팅\",\n      \"relation\": \"기준으로 삼는다\",\n      \"to\": \"라우팅 테이블\",\n      \"description\": \"라우팅은 라우팅 테이블을 기준으로 패킷을 특정 인터페이스로 출력하는 것으로 설명됩니다.\"\n    },\n    {\n      \"from\": \"라우터 기능\",\n      \"relation\": \"포함한다\",\n      \"to\": \"패킷 스위칭\"\n    },\n    {\n      \"from\": \"라우터 기능\",\n      \"relation\": \"포함한다\",\n      \"to\": \"경로 선택\"\n    },\n    {\n      \"from\": \"IGP\",\n      \"relation\": \"분류로 제시한다\",\n      \"to\": \"Distance vector\",\n      \"description\": \"자료는 IGP의 경로 계산 방식으로 distance vector를 제시합니다.\"\n    },\n    {\n      \"from\": \"IGP\",\n      \"relation\": \"분류로 제시한다\",\n      \"to\": \"Link state\",\n      \"description\": \"자료는 IGP의 경로 계산 방식으로 link state를 제시합니다.\"\n    },\n    {\n      \"from\": \"IGP\",\n      \"relation\": \"분류로 제시한다\",\n      \"to\": \"Hybrid\"\n    },\n    {\n      \"from\": \"정적 라우팅\",\n      \"relation\": \"사용할 수 있다\",\n      \"to\": \"디폴트 라우트\",\n      \"description\": \"자료는 정적 구성 방식 중 기본 방식으로 디폴트 라우트를 설명합니다.\"\n    },\n    {\n      \"from\": \"Stub network\",\n      \"relation\": \"디폴트 라우트와 함께 언급된다\",\n      \"to\": \"디폴트 라우트\",\n      \"description\": \"자료에서는 stub network에서 디폴트 라우트를 사용하는 경우를 설명합니다.\"\n    },\n    {\n      \"from\": \"동적 라우팅\",\n      \"relation\": \"예시로 설정한다\",\n      \"to\": \"RIP\"\n    },\n    {\n      \"from\": \"Floating route\",\n      \"relation\": \"보조 경로로 사용한다\",\n      \"to\": \"정적 라우팅\",\n      \"description\": \"자료의 플로팅 라우트 구성 예시는 정적 경로 명령을 사용합니다.\"\n    }\n  ],\n  \"theory\": {\n    \"definitions\": [\n      {\n        \"subject\": \"라우팅\",\n        \"content\": \"라우팅 테이블을 기준으로 패킷을 특정 인터페이스로 출력하는 과정으로 설명됩니다.\",\n        \"evidence\": \"라우팅이 됐다는 얘기는 라우팅 테이블 매핑을 거쳐 패킷을 특정 인터페이스로 출력\"\n      },\n      {\n        \"subject\": \"Stub network\",\n        \"content\": \"자료에서는 외부와 통하는 인터페이스가 단 1개인 네트워크라고 정의합니다.\",\n        \"evidence\": \"stub network : 외부와 통하는 인터페이스가 단 1개인 네트워크\"\n      },\n      {\n        \"subject\": \"AD\",\n        \"content\": \"자료에서는 관리 거리이며, 특정 네트워크 정보를 2개 이상 경로로 학습한 경우 우선 경로를 판단하는 기준이라고 설명합니다.\",\n        \"evidence\": \"AD란 관리 거리를 의미하며 특정 네트워크 정보를 2개 이상 경로로 학습한 경우 우선하는 경로를 판단하는 기준으로 사용\"\n      }\n    ],\n    \"principles\": [\n      {\n        \"subject\": \"라우팅 경로 선택 순서\",\n        \"content\": \"자료에서는 테이블 룩업에서 프리픽스 길이를 비교하고, 이어서 AD가 낮은 경로와 cost가 낮은 경로를 우선하는 순서를 제시합니다.\",\n        \"evidence\": \"1. 테이블 룩업(다른 서브넷 회선이 2개 이상 적용되는 IP가 둘다 통과 가능한 아이피 대역인경우 프리픽스 길이가 긴쪽을 우선함) _longest prefix\\n2. AD값이 적은게 우선시함  192.168.4.0[(1)/0] via ....\\n3. cost 낮은 비용을 우선시함\",\n        \"related_concepts\": [\n          \"라우팅 테이블\",\n          \"Longest prefix\",\n          \"AD\",\n          \"Cost\"\n        ]\n      },\n      {\n        \"subject\": \"Floating route\",\n        \"content\": \"목적지로 갈 수 있는 잉여 회선이 있는 경우 주 경로와 보조 경로를 지정하여 주 경로 장애 시 보조 경로가 동작하도록 하는 방식으로 설명합니다.\",\n        \"evidence\": \"플로팅 라우트는 목적지로 갈수 있는 잉여 회선이 있는 경우 주경로와 보조 경로를 지정하여 주 경로 장애 발생 시 보조경로가 동작하도록 하여 장애 내성\",\n        \"related_concepts\": [\n          \"Floating route\",\n          \"정적 라우팅\",\n          \"AD\"\n        ]\n      },\n      {\n        \"subject\": \"Stub network와 디폴트 라우트\",\n        \"content\": \"자료에서는 stub network가 모든 IP에 대해 패킷을 수신·송신한다고 설명하며 보안성이 없다고 서술합니다. 또한 인터페이스가 1개를 초과할 때 디폴트 라우트를 설정하면 패킷이 일부 소실될 수 있다고 설명합니다.\",\n        \"evidence\": \"-> 인터페이스 1개 초과일때 위와 같이 디폴트 라우트 설정(stub network에서 설정하듯이) 해버리면 패킷이 반절 소실되는 상황이 발생할 수 있다.\\n1타임아웃 2핑성공 3타임아웃 4핑성공\\nstub network 는 모든 아이피에 대해 패킷을 수신 송신하므로 보안성이 없다.\",\n        \"related_concepts\": [\n          \"Stub network\",\n          \"디폴트 라우트\"\n        ]\n      }\n    ],\n    \"comparisons\": [\n      {\n        \"subject_a\": \"IGP\",\n        \"subject_b\": \"EGP\",\n        \"criteria\": [\n          \"적용 범위\",\n          \"라우팅 영역\"\n        ],\n        \"evidence\": \"IGP 하나의 AS에서..\\n경로 계산 방식\\ndistance vector 주기적\\nlink state 네트워크 상태가 변했을때\\nadveanced distance vecrtor 위에 두가지 믹싱해서 나온기술\\nEGP 서로 다른 AS에서...\",\n        \"related_concepts\": [\n          \"IGP\",\n          \"EGP\"\n        ]\n      },\n      {\n        \"subject_a\": \"Distance vector\",\n        \"subject_b\": \"Link state\",\n        \"criteria\": [\n          \"정보 교환 시점\"\n        ],\n        \"evidence\": \"distance vector 주기적\\nlink state 네트워크 상태가 변했을때\",\n        \"related_concepts\": [\n          \"Distance vector\",\n          \"Link state\"\n        ]\n      },\n      {\n        \"subject_a\": \"물리적 분리\",\n        \"subject_b\": \"논리적 분리\",\n        \"criteria\": [\n          \"분리 기준\"\n        ],\n        \"evidence\": \"1. 물리적 분리 : 라우터 or l3 스위치 물리적 포트를 기준으로 나뉜 네트워크\\n2. 논리적 분리 : vlan으로 나뉜 네트워크\"\n      }\n    ]\n  },\n  \"practice\": [\n    {\n      \"title\": \"정적 라우팅 설정\",\n      \"description\": \"ip route 명령으로 목적지 네트워크와 출력 인터페이스를 지정하는 명령 예시가 있습니다. 실행 성공 여부는 제시되지 않습니다.\",\n      \"evidence\": \"ip route 192.168.2.0 255.255.255.0 s2/0\",\n      \"related_concepts\": [\n        \"정적 라우팅\",\n        \"라우팅 테이블\"\n      ]\n    },\n    {\n      \"title\": \"디폴트 라우트 설정 및 삭제\",\n      \"description\": \"디폴트 경로 설정과 기존 정적 경로 삭제 명령 예시가 포함되어 있습니다. 실행 결과는 제시되지 않습니다.\",\n      \"evidence\": \"no ip route 192.168.2.0 255.255.255.0 Serial2/0\\nno ip route 192.168.3.0 255.255.255.0 Serial2/0\\nno ip route 192.168.4.0 255.255.255.128 Serial2/0\\nno ip route 192.168.4.128 255.255.255.128 Serial2/0\\nip route 0.0.0.0 0.0.0.0 Serial2/0\",\n      \"related_concepts\": [\n        \"디폴트 라우트\",\n        \"Stub network\",\n        \"정적 라우팅\"\n      ]\n    },\n    {\n      \"title\": \"RIP 동적 라우팅 설정\",\n      \"description\": \"R1과 R2에서 RIP을 활성화하고 네트워크를 지정하는 명령 예시가 있습니다. 원격지 학습 결과는 제시되지 않습니다.\",\n      \"evidence\": \"R1\\nconf t\\nrouter rip\\nnet 192.168.1.0\\nnet 192.168.12.0\\nip route 192.168.2.0 255.255.255.0 s2/0\\nip route 192.168.2.0 255.255.255.0 192.168.12.2\\nrouter rip\\nR2\\nconf t\\nrouter rip\\nnet 192.168.2.0\\nnet 192.168.12.0\",\n      \"related_concepts\": [\n        \"동적 라우팅\",\n        \"RIP\"\n      ]\n    },\n    {\n      \"title\": \"플로팅 라우트 구성\",\n      \"description\": \"원문에서 보조 경로로 표시한 AD 10의 정적 경로 명령 예시다. 실제로 백업이 되는지는 주 경로와의 AD 비교가 필요하며 장애 전환 결과는 기록되어 있지 않다.\",\n      \"evidence\": \"ip route 192.168.2.0 255.255.255.0 s2/0 10\",\n      \"related_concepts\": [\n        \"Floating route\",\n        \"정적 라우팅\",\n        \"AD\"\n      ]\n    }\n  ],\n  \"schema_version\": \"0.2-draft\",\n  \"sections\": [\n    {\n      \"id\": \"router-basics\",\n      \"title\": \"라우팅 기본 기능과 네트워크 분리\",\n      \"content_refs\": [\n        \"/concepts/0\",\n        \"/concepts/1\",\n        \"/concepts/2\",\n        \"/concepts/3\",\n        \"/concepts/4\",\n        \"/concepts/5\",\n        \"/concepts/6\",\n        \"/relationships/0\",\n        \"/relationships/1\",\n        \"/relationships/2\",\n        \"/theory/definitions/0\",\n        \"/theory/comparisons/2\"\n      ]\n    },\n    {\n      \"id\": \"routing-families\",\n      \"title\": \"IGP·EGP와 경로 계산 방식\",\n      \"content_refs\": [\n        \"/concepts/7\",\n        \"/concepts/8\",\n        \"/concepts/9\",\n        \"/concepts/10\",\n        \"/concepts/11\",\n        \"/relationships/3\",\n        \"/relationships/4\",\n        \"/relationships/5\",\n        \"/theory/comparisons/0\",\n        \"/theory/comparisons/1\"\n      ]\n    },\n    {\n      \"id\": \"static-routes\",\n      \"title\": \"정적 라우팅 설정\",\n      \"content_refs\": [\n        \"/concepts/12\",\n        \"/practice/0\"\n      ]\n    },\n    {\n      \"id\": \"default-stub\",\n      \"title\": \"디폴트 라우트와 Stub network\",\n      \"content_refs\": [\n        \"/concepts/13\",\n        \"/concepts/14\",\n        \"/relationships/6\",\n        \"/relationships/7\",\n        \"/theory/definitions/1\",\n        \"/theory/principles/2\",\n        \"/practice/1\"\n      ]\n    },\n    {\n      \"id\": \"route-selection\",\n      \"title\": \"최장 프리픽스·AD·메트릭\",\n      \"content_refs\": [\n        \"/concepts/15\",\n        \"/concepts/16\",\n        \"/concepts/17\",\n        \"/theory/definitions/2\",\n        \"/theory/principles/0\"\n      ]\n    },\n    {\n      \"id\": \"rip-floating\",\n      \"title\": \"RIP 설정과 플로팅 라우트\",\n      \"content_refs\": [\n        \"/concepts/18\",\n        \"/concepts/19\",\n        \"/concepts/20\",\n        \"/relationships/8\",\n        \"/relationships/9\",\n        \"/theory/principles/1\",\n        \"/practice/2\",\n        \"/practice/3\"\n      ]\n    }\n  ],\n  \"source\": {\n    \"material_id\": \"bc86db8089b8e84a49a80114657d596b3458b9d124880bb7b2965844526661a5\",\n    \"filename\": \"12일차.docx\",\n    \"extension\": \".docx\"\n  }\n}\n"
