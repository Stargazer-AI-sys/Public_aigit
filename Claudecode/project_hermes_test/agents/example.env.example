# 인스턴스 설정 예시. 비밀값(봇 토큰, 로그인)은 여기에 쓰지 않는다.
# `hermes-agent.sh new <name> <target>`가 이 파일을 복사해 agents/<name>.env를 만든다.
AGENT_NAME=example
TARGET=example
# 태그나 다이제스트로 고정한다. latest는 의도치 않은 버전 변경을 부른다.
IMAGE=nousresearch/hermes-agent:latest
# 컨테이너 메모리 한도. 서버 2GB 기준 인스턴스 1개 대기 시 약 340MiB(1회 측정)였다.
MEM_LIMIT=600m
